*.pem
*.key
.env
*_rsa
*_ed25519
.zshrc.local
.DS_Store
devin/

# Live credentials that must go through bin/dots-secrets (1Password), never
# git — that script's whole purpose is keeping these out of the repo, but
# they got committed anyway before it existed. *.key above doesn't match
# "keys.txt" (plural, .txt extension), which is why this slipped through.
starship/.config/sops/age/keys.txt
starship/.config/rclone/rclone.conf

# 1Password CLI's own config (device id, sign-in state) — the `op` CLI
# refuses to run at all when ~/.config/op is a symlink (hardened against
# exactly the "symlinked into who-knows-where" pattern this repo used).
# Per-machine state anyway, nothing worth versioning.
starship/.config/op/

# Claude Code invents new local-state directories under ~/.claude over time
# (image-cache showed up mid-session while writing this file) — a blocklist
# of known-bad ones always lags behind and leaks the next one. Allowlist
# instead: ignore everything under claude/.claude/ except the files we
# actually hand-author. Add a `!claude/.claude/<path>` line here whenever a
# new file is deliberately meant to be tracked (e.g. the rtk-generated hook,
# once verified — rtk init -g regenerates settings.json in place, no new
# line needed for that one).
claude/.claude/*
!claude/.claude/settings.json
!claude/.claude/CLAUDE.md
