#!/usr/bin/env bash
# dots-secrets — sync machine secrets (SSH keys, sops key, rclone/aws config, env
# files) to/from 1Password, since these can't live in the (public-clonable) git repo.
#
# Usage:
#   dots-secrets push     upload local files -> 1Password (create or overwrite)
#   dots-secrets pull     download files from 1Password -> local paths (skips
#                          any path that already exists locally)
#   dots-secrets status   compare local vs 1Password: missing / drifted / in sync
#
# Vault defaults to "Private" — override with DOTS_SECRETS_VAULT=<name>.

set -uo pipefail

VAULT="${DOTS_SECRETS_VAULT:-Private}"
TAG="dotfiles-machine"

# path:title:chmod-mode  (one secret per line; title must not contain ':')
SECRETS=(
  "$HOME/.ssh/id_ed25519:SSH key - id_ed25519:0600"
  "$HOME/.ssh/id_ed25519.pub:SSH key - id_ed25519.pub:0644"
  "$HOME/.ssh/id_rsa:SSH key - id_rsa:0600"
  "$HOME/.ssh/id_rsa.pub:SSH key - id_rsa.pub:0644"
  "$HOME/.config/sops/age/keys.txt:SOPS age key:0600"
  "$HOME/.config/rclone/rclone.conf:rclone config (pCloud):0600"
  "$HOME/.aws/config:AWS config:0600"
  "$HOME/Code/prod.env:leplein prod.env:0600"
  "$HOME/Code/staging.env:leplein staging.env:0600"
  "$HOME/.config/mcp-grafana/token:Grafana MCP - service account token:0600"
)

BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
RESET='\033[0m'

ok()   { echo -e "  ${GREEN}✓${RESET} $1"; }
warn() { echo -e "  ${YELLOW}⚠${RESET}  $1"; }
err()  { echo -e "  ${RED}✗${RESET} $1"; }
step() { echo -e "\n${CYAN}▶ ${BOLD}$1${RESET}"; }

_require_op() {
  command -v op &>/dev/null || {
    err "1Password CLI not installed — run: brew install --cask 1password-cli"
    exit 1
  }
  op vault list &>/dev/null || {
    err "1Password CLI not signed in."
    echo "    Open the 1Password app -> Settings -> Developer -> enable"
    echo "    'Integrate with 1Password CLI', then re-run this command."
    exit 1
  }
}

_item_exists() {
  op item get "$1" --vault "$VAULT" &>/dev/null
}

cmd_push() {
  _require_op
  step "Pushing secrets to 1Password vault \"$VAULT\""
  for entry in "${SECRETS[@]}"; do
    IFS=':' read -r path title mode <<<"$entry"
    if [ ! -f "$path" ]; then
      warn "$title — local file missing ($path), skipped"
      continue
    fi
    if _item_exists "$title"; then
      if op document edit "$title" "$path" --vault "$VAULT" &>/dev/null; then
        ok "$title — updated"
      else
        err "$title — update failed"
      fi
    else
      if op document create "$path" --title "$title" --vault "$VAULT" --tags "$TAG" &>/dev/null; then
        ok "$title — created"
      else
        err "$title — create failed"
      fi
    fi
  done
}

cmd_pull() {
  _require_op
  step "Pulling secrets from 1Password vault \"$VAULT\""
  for entry in "${SECRETS[@]}"; do
    IFS=':' read -r path title mode <<<"$entry"
    if [ -f "$path" ]; then
      warn "$title — local file already exists at $path, left untouched"
      continue
    fi
    if ! _item_exists "$title"; then
      warn "$title — not found in 1Password, skipped"
      continue
    fi
    mkdir -p "$(dirname "$path")"
    if op document get "$title" --vault "$VAULT" --out-file "$path" &>/dev/null; then
      chmod "$mode" "$path"
      ok "$title -> $path"
    else
      err "$title — download failed"
    fi
  done
}

cmd_status() {
  _require_op
  step "Secrets status — vault \"$VAULT\""
  for entry in "${SECRETS[@]}"; do
    IFS=':' read -r path title mode <<<"$entry"
    local_exists="no"
    [ -f "$path" ] && local_exists="yes"
    remote_exists="no"
    _item_exists "$title" && remote_exists="yes"

    if [ "$local_exists" = yes ] && [ "$remote_exists" = yes ]; then
      local_hash=$(shasum -a 256 "$path" | awk '{print $1}')
      remote_hash=$(op document get "$title" --vault "$VAULT" 2>/dev/null | shasum -a 256 | awk '{print $1}')
      if [ "$local_hash" = "$remote_hash" ]; then
        ok "$title — in sync"
      else
        warn "$title — DRIFTED, local != 1Password — run: dots secrets push"
      fi
    elif [ "$local_exists" = yes ]; then
      warn "$title — only local, not in 1Password — run: dots secrets push"
    elif [ "$remote_exists" = yes ]; then
      warn "$title — only in 1Password, not local — run: dots secrets pull"
    else
      err "$title — missing everywhere ($path)"
    fi
  done
}

case "${1:-status}" in
  push) cmd_push ;;
  pull) cmd_pull ;;
  status) cmd_status ;;
  *)
    echo "Usage: dots-secrets <push|pull|status>"
    exit 1
    ;;
esac
