<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rclone.pcloud</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/rclone</string>
        <string>mount</string>
        <string>pcloud:</string>
        <string>/Users/christophe/pcloud-mount</string>
        <string>--vfs-cache-mode</string>
        <string>writes</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/rclone-pcloud.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/rclone-pcloud.err</string>
</dict>
</plist>
